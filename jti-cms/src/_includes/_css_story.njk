
    :root{
      --paper:#F5F0E6;--paper-deep:#E9E2D4;--ink:#2B2B26;--body:#3F3E36;
      --green:#1F3D2B;--green-soft:#2E4A38;--red:#7B2E2A;--gold:#8A7E63;--line:#D8CFBA;
      --serif:'Cormorant', Georgia, 'Times New Roman', serif;
      --garamond:'EB Garamond', Georgia, serif;
      --sans:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;
    }
    *{box-sizing:border-box;}
    html{scroll-behavior:smooth;}
    body{margin:0;background:var(--paper);color:var(--body);font-family:var(--garamond);font-size:20px;line-height:1.75;-webkit-font-smoothing:antialiased;}
    img{display:block;max-width:100%;}
    a{color:var(--green);}
    .progress{position:fixed;top:0;left:0;height:3px;width:0;background:var(--red);z-index:100;transition:width .1s linear;}
    .nav{position:relative;z-index:20;display:flex;align-items:center;justify-content:space-between;padding:20px 40px;background:var(--paper);border-bottom:1px solid var(--line);}
    .brand{display:flex;align-items:center;gap:10px;}
    .brand .jti{font-family:var(--serif);font-weight:600;font-size:22px;letter-spacing:2px;color:var(--green);}
    .brand .sq{width:10px;height:10px;background:var(--red);}
    .brand .full{font-family:var(--sans);font-size:10px;letter-spacing:3px;color:var(--gold);text-transform:uppercase;}
    .nav .back{font-family:var(--sans);font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--gold);text-decoration:none;}
    .nav .back:hover{color:var(--red);}
    .hero{position:relative;height:84vh;min-height:540px;display:flex;align-items:flex-end;background:linear-gradient(160deg,#6E4633 0%,#2C1D15 100%);overflow:hidden;}
    .hero-img{position:absolute;inset:0;background-size:cover;background-position:center;}
    .hero-overlay{position:absolute;inset:0;background:linear-gradient(to top,rgba(28,16,10,.84) 0%,rgba(28,16,10,.28) 55%,rgba(28,16,10,.16) 100%);}
    .hero-inner{position:relative;z-index:2;max-width:820px;margin:0 auto;width:100%;padding:0 40px 64px;}
    .kicker{font-family:var(--sans);font-size:12px;letter-spacing:4px;text-transform:uppercase;color:#fff;margin:0 0 22px;}
    .kicker b{color:var(--red);font-weight:500;}
    .hero h1{font-family:var(--serif);font-weight:500;color:var(--paper);font-size:60px;line-height:1.05;margin:0 0 24px;}
    .byline{font-family:var(--sans);font-size:13px;letter-spacing:1.5px;color:#E7E0D2;text-transform:uppercase;}
    .byline .dot{color:var(--red);margin:0 10px;}
    .wrap{max-width:720px;margin:0 auto;padding:0 40px;}
    .standfirst{font-family:var(--garamond);font-style:italic;font-size:25px;line-height:1.55;color:var(--green);margin:64px 0 14px;padding-bottom:38px;border-bottom:1px solid var(--line);}
    .meta-row{display:flex;gap:28px;flex-wrap:wrap;font-family:var(--sans);font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--gold);margin:0 0 50px;}
    .meta-row span b{color:var(--ink);font-weight:500;display:block;margin-top:4px;letter-spacing:1px;font-size:12px;}
    p{margin:0 0 28px;}
    .article > p:first-of-type::first-letter{font-family:var(--serif);float:left;font-size:78px;line-height:.78;font-weight:600;color:var(--red);margin:8px 14px 0 0;}
    h2.sub{font-family:var(--serif);font-weight:500;font-size:32px;line-height:1.2;color:var(--green);margin:52px 0 22px;}
    .pull{font-family:var(--serif);font-style:italic;font-weight:500;font-size:30px;line-height:1.35;color:var(--green);text-align:center;margin:54px auto;max-width:640px;position:relative;}
    .pull::before{content:"";display:block;width:36px;height:3px;background:var(--red);margin:0 auto 26px;}
    figure{margin:56px 0;}
    .figure-band{width:100%;height:440px;background:linear-gradient(135deg,#6E4633,#2C1D15);display:flex;align-items:center;justify-content:center;}
    .figure-band .ph{font-family:var(--sans);font-size:11px;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,.8);}
    figcaption{font-family:var(--sans);font-size:12px;letter-spacing:.5px;color:var(--gold);margin-top:12px;text-align:center;font-style:normal;}
    figcaption b{color:var(--ink);font-weight:500;}
    .gallery{display:grid;grid-template-columns:1fr 1fr;gap:14px;margin:56px 0;}
    .gallery .cell{height:230px;background:linear-gradient(135deg,#7A4A33,#3A2419);display:flex;align-items:center;justify-content:center;}
    .gallery .cell:nth-child(2){background:linear-gradient(135deg,#8A5A2E,#43290F);}
    .gallery .ph{font-family:var(--sans);font-size:10px;letter-spacing:2px;text-transform:uppercase;color:rgba(255,255,255,.75);}
    .guide{display:flex;gap:24px;align-items:center;background:var(--paper-deep);border:1px solid var(--line);padding:28px 30px;margin:56px 0;}
    .guide .avatar{flex:0 0 84px;width:84px;height:84px;border-radius:50%;background:linear-gradient(135deg,#6E4633,#2C1D15);display:flex;align-items:center;justify-content:center;font-family:var(--serif);color:var(--paper);font-size:26px;}
    .guide .who{font-family:var(--sans);font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--red);margin:0 0 6px;}
    .guide .name{font-family:var(--serif);font-size:22px;color:var(--green);margin:0 0 8px;}
    .guide p{font-size:17px;line-height:1.6;margin:0;color:var(--body);}
    .endmark{width:9px;height:9px;background:var(--red);margin:48px auto 0;}
    .cta{background:var(--green);color:var(--paper);text-align:center;padding:74px 40px;margin-top:80px;}
    .cta .k{font-family:var(--sans);font-size:12px;letter-spacing:4px;text-transform:uppercase;color:var(--red);margin:0 0 18px;}
    .cta h3{font-family:var(--serif);font-weight:500;font-size:34px;line-height:1.2;margin:0 auto 18px;max-width:560px;}
    .cta p{font-family:var(--garamond);font-style:italic;font-size:18px;color:#CFD8C8;max-width:520px;margin:0 auto 34px;}
    .btn{display:inline-block;background:var(--red);color:var(--paper);font-family:var(--sans);font-size:13px;letter-spacing:2px;text-transform:uppercase;padding:16px 38px;text-decoration:none;}
    .btn:hover{background:#5F231F;}
    .related{max-width:1040px;margin:0 auto;padding:80px 40px 30px;}
    .related .label{text-align:center;font-family:var(--sans);font-size:12px;letter-spacing:4px;text-transform:uppercase;color:var(--gold);margin:0 0 40px;}
    .cards{display:grid;grid-template-columns:repeat(3,1fr);gap:24px;}
    .card{text-decoration:none;display:block;}
    .card .thumb{height:200px;background:linear-gradient(135deg,#243A2C,#0E1813);margin-bottom:16px;}
    .card:nth-child(2) .thumb{background:linear-gradient(135deg,#4A5A66,#1C2630);}
    .card:nth-child(3) .thumb{background:linear-gradient(135deg,#2E4A38,#16241B);}
    .card .ck{font-family:var(--sans);font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--gold);}
    .card .ct{font-family:var(--serif);font-size:21px;line-height:1.25;color:var(--green);margin:8px 0 0;}
    footer{background:var(--paper);border-top:1px solid var(--line);text-align:center;padding:48px 40px 56px;margin-top:40px;}
    footer .brand{justify-content:center;margin-bottom:16px;}
    footer .links{font-family:var(--sans);font-size:12px;letter-spacing:1px;color:#6B6A60;margin:0 0 14px;}
    footer .links a{color:#6B6A60;text-decoration:none;margin:0 10px;}
    footer .fine{font-family:var(--sans);font-size:11px;color:#9A9182;line-height:1.6;margin:0;}
    @media (max-width:760px){
      body{font-size:18px;}.nav{padding:16px 22px;}.brand .full{display:none;}
      .hero{height:72vh;min-height:440px;}.hero-inner{padding:0 24px 40px;}.hero h1{font-size:38px;}
      .wrap{padding:0 24px;}.standfirst{font-size:21px;margin-top:44px;}.pull{font-size:24px;}
      .figure-band{height:260px;}.gallery{grid-template-columns:1fr;}.guide{flex-direction:column;text-align:center;}.cards{grid-template-columns:1fr;}
    }
  
/* ---- in-body images, headings & quotes added via the content editor ---- */
.article img{display:block;width:100%;margin:44px 0;border:1px solid var(--line);box-shadow:0 14px 40px rgba(31,61,43,.14);}
.article figure{margin:44px 0;}
.article figure img{margin:0;}
.article figcaption{font-family:var(--sans);font-size:12px;letter-spacing:.5px;color:var(--gold);margin-top:12px;text-align:center;}
.article h2{font-family:var(--serif);font-weight:500;font-size:32px;line-height:1.2;color:var(--green);margin:52px 0 22px;}
.article h3{font-family:var(--serif);font-weight:500;font-size:24px;line-height:1.25;color:var(--green);margin:40px 0 16px;}
.article blockquote{font-family:var(--serif);font-style:italic;font-weight:500;font-size:30px;line-height:1.35;color:var(--green);text-align:center;margin:54px auto;max-width:640px;border:0;padding:0;}
.article blockquote::before{content:"";display:block;width:36px;height:3px;background:var(--red);margin:0 auto 26px;}
.article blockquote p{margin:0;}
.article ul,.article ol{margin:0 0 28px 22px;}
@media(max-width:760px){.article h2{font-size:26px;}.article blockquote{font-size:24px;}.article img{margin:28px 0;}}
