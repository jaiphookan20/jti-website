
    :root{
      --paper:#F5F0E6;--paper-deep:#E9E2D4;--ink:#2B2B26;--body:#3F3E36;
      --green:#1F3D2B;--green-soft:#2E4A38;--red:#7B2E2A;--red-dark:#5F231F;--gold:#8A7E63;--line:#D8CFBA;--sand:#D9B48A;
      --serif:'Cormorant', Georgia, serif;
      --garamond:'EB Garamond', Georgia, serif;
      --sans:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;
    }
    *{box-sizing:border-box;margin:0;padding:0;}
    html{scroll-behavior:smooth;}
    body{background:var(--paper);color:var(--body);font-family:var(--garamond);font-size:19px;line-height:1.7;-webkit-font-smoothing:antialiased;overflow-x:hidden;}
    img{display:block;max-width:100%;}
    a{color:inherit;text-decoration:none;}
    .wrap{max-width:1200px;margin:0 auto;padding:0 40px;}
    .eyebrow{font-family:var(--sans);font-size:12px;letter-spacing:4px;text-transform:uppercase;color:var(--red);font-weight:500;}
    h1,h2,h3{font-family:var(--serif);font-weight:500;color:var(--green);line-height:1.14;}
    .btn{display:inline-block;font-family:var(--sans);font-size:13px;letter-spacing:2px;text-transform:uppercase;padding:15px 32px;cursor:pointer;transition:.2s;border:none;}
    .btn-red{background:var(--red);color:var(--paper);}.btn-red:hover{background:var(--red-dark);}
    .btn-ghost{border:1px solid var(--paper);color:var(--paper);}.btn-ghost:hover{background:var(--paper);color:var(--green);}
    .btn-outline{border:1px solid var(--green);color:var(--green);}.btn-outline:hover{background:var(--green);color:var(--paper);}
    .center-mark{width:8px;height:8px;background:var(--red);}

    /* top bar + nav (shared) */
    .topbar{background:var(--green);color:var(--paper);font-family:var(--sans);font-size:12px;letter-spacing:1.5px;text-transform:uppercase;}
    .topbar .wrap{display:flex;justify-content:space-between;align-items:center;padding:9px 40px;}
    .topbar a{color:var(--paper);opacity:.9;}.topbar .t-left span{color:#CFD8C8;}
    header.nav{position:sticky;top:0;z-index:50;background:rgba(245,240,230,.96);backdrop-filter:blur(6px);border-bottom:1px solid var(--line);}
    .nav .wrap{display:flex;align-items:center;justify-content:space-between;padding:16px 40px;}
    .brand{display:flex;align-items:center;gap:11px;}
    .brand .jti{font-family:var(--serif);font-weight:600;font-size:26px;letter-spacing:2px;color:var(--green);}
    .brand .sq{width:11px;height:11px;background:var(--red);}
    .brand .full{font-family:var(--sans);font-size:10px;letter-spacing:3px;color:var(--gold);text-transform:uppercase;line-height:1.3;max-width:90px;}
    .menu{display:flex;align-items:center;gap:30px;font-family:var(--sans);font-size:13px;letter-spacing:1.5px;text-transform:uppercase;color:var(--ink);}
    .menu a:hover{color:var(--red);}
    .menu .enquire{background:var(--red);color:var(--paper);padding:12px 24px;letter-spacing:2px;}
    .menu .enquire:hover{background:var(--red-dark);}
    .burger{display:none;flex-direction:column;gap:5px;cursor:pointer;}
    .burger span{width:26px;height:2px;background:var(--green);}

    /* page hero */
    .phero{position:relative;height:52vh;min-height:380px;display:flex;align-items:flex-end;color:var(--paper);}
    .phero img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;}
    .phero .scrim{position:absolute;inset:0;background:linear-gradient(to top,rgba(15,20,15,.85),rgba(15,20,15,.25) 70%);}
    .phero .inner{position:relative;z-index:2;padding-bottom:48px;}
    .phero .eyebrow{color:var(--sand);}
    .phero h1{color:var(--paper);font-size:56px;margin:16px 0 14px;}
    .phero p{color:#EDE7DA;font-family:var(--garamond);font-style:italic;font-size:20px;max-width:560px;}
    .crumbs{position:relative;z-index:2;}
    .crumbs .wrap{padding:14px 40px;font-family:var(--sans);font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--gold);}
    .crumbs a:hover{color:var(--red);}

    /* filter bar */
    .filter{position:sticky;top:69px;z-index:40;background:var(--paper);border-bottom:1px solid var(--line);}
    .filter .wrap{display:flex;justify-content:center;gap:8px;padding:18px 40px;flex-wrap:wrap;}
    .filter button{font-family:var(--sans);font-size:12px;letter-spacing:2px;text-transform:uppercase;color:var(--body);background:none;border:1px solid var(--line);padding:11px 24px;cursor:pointer;transition:.2s;}
    .filter button:hover{border-color:var(--green);}
    .filter button.active{background:var(--green);color:var(--paper);border-color:var(--green);}

    /* tours grid */
    .tours{padding:70px 0 40px;}
    .grid{display:grid;grid-template-columns:repeat(3,1fr);gap:28px;}
    .card{background:var(--paper);border:1px solid var(--line);display:flex;flex-direction:column;transition:.25s;overflow:hidden;}
    .card:hover{transform:translateY(-4px);box-shadow:0 18px 44px rgba(31,61,43,.14);}
    .card .ph{height:240px;overflow:hidden;position:relative;}
    .card .ph img{width:100%;height:100%;object-fit:cover;transition:.55s;}
    .card:hover .ph img{transform:scale(1.06);}
    .card .cat{position:absolute;top:16px;left:16px;font-family:var(--sans);font-size:10px;letter-spacing:2px;text-transform:uppercase;color:var(--paper);background:rgba(31,61,43,.86);padding:6px 12px;}
    .card .body{padding:26px 26px 28px;display:flex;flex-direction:column;flex:1;}
    .card .tags{font-family:var(--sans);font-size:11px;letter-spacing:1.5px;text-transform:uppercase;color:var(--gold);margin-bottom:12px;}
    .card .tags b{color:var(--red);font-weight:500;}
    .card h3{font-size:23px;line-height:1.2;margin-bottom:12px;}
    .card p{font-size:15.5px;line-height:1.55;color:var(--body);margin-bottom:20px;flex:1;}
    .card .foot{display:flex;justify-content:space-between;align-items:center;border-top:1px solid var(--line);padding-top:16px;}
    .card .foot .view{font-family:var(--sans);font-size:12px;letter-spacing:1.5px;text-transform:uppercase;color:var(--green);border-bottom:1px solid var(--red);padding-bottom:2px;}
    .card .foot .enq{font-family:var(--sans);font-size:12px;letter-spacing:1.5px;text-transform:uppercase;color:var(--gold);}
    .card.hide{display:none;}

    /* tailor band */
    .tailor{position:relative;color:var(--paper);margin-top:40px;}
    .tailor img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;}
    .tailor .scrim{position:absolute;inset:0;background:rgba(20,32,22,.88);}
    .tailor .inner{position:relative;z-index:2;text-align:center;max-width:640px;margin:0 auto;padding:82px 40px;}
    .tailor .center-mark{margin:0 auto 22px;}
    .tailor .eyebrow{color:var(--sand);}
    .tailor h2{color:var(--paper);font-size:40px;margin:16px 0 18px;}
    .tailor p{color:#CFD8C8;margin-bottom:28px;}

    /* footer (shared) */
    footer.site{background:#16241B;color:#B9C7B4;padding:64px 0 30px;}
    footer.site .grid-f{display:grid;grid-template-columns:1.4fr 1fr 1fr 1.2fr;gap:44px;}
    footer.site .brand .jti{color:var(--paper);}
    footer.site .brand .full{color:#8A9A85;}
    footer.site p.tag{margin-top:18px;font-size:15px;line-height:1.6;color:#9DAD97;max-width:280px;}
    footer.site h4{font-family:var(--sans);font-size:12px;letter-spacing:2px;text-transform:uppercase;color:var(--paper);margin-bottom:18px;}
    footer.site ul{list-style:none;}footer.site li{margin-bottom:11px;font-family:var(--sans);font-size:13px;}
    footer.site li a:hover{color:var(--paper);}
    footer.site .contact{font-family:var(--sans);font-size:13px;line-height:1.9;}
    footer.site .contact a{color:var(--sand);}
    footer.site .sub{border-top:1px solid rgba(255,255,255,.1);margin-top:48px;padding-top:22px;display:flex;justify-content:space-between;font-family:var(--sans);font-size:11px;letter-spacing:1px;color:#7E8E79;flex-wrap:wrap;gap:10px;}
    .wa{position:fixed;right:22px;bottom:22px;z-index:60;background:var(--red);color:var(--paper);font-family:var(--sans);font-size:13px;letter-spacing:1.5px;text-transform:uppercase;padding:14px 22px;box-shadow:0 10px 30px rgba(0,0,0,.25);}
    .wa:hover{background:var(--red-dark);}

    @media (max-width:1000px){.grid{grid-template-columns:1fr 1fr;}}
    @media (max-width:820px){
      .wrap{padding:0 24px;}.topbar .wrap,.nav .wrap,.crumbs .wrap,.filter .wrap{padding-left:24px;padding-right:24px;}
      .menu{display:none;}.burger{display:flex;}
      .phero h1{font-size:38px;}.grid{grid-template-columns:1fr;}
      footer.site .grid-f{grid-template-columns:1fr 1fr;gap:30px;}
      .filter{top:65px;}
    }
  