
    :root{
      --paper:#F5F0E6;--paper-deep:#E9E2D4;--ink:#2B2B26;--body:#3F3E36;
      --green:#1F3D2B;--green-soft:#2E4A38;--red:#7B2E2A;--red-dark:#5F231F;--gold:#8A7E63;--line:#D8CFBA;--sand:#D9B48A;
      --serif:'Cormorant', Georgia, serif;
      --garamond:'EB Garamond', Georgia, serif;
      --sans:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;
    }
    *{box-sizing:border-box;margin:0;padding:0;}
    html{scroll-behavior:smooth;}
    body{background:var(--paper);color:var(--body);font-family:var(--garamond);font-size:19px;line-height:1.75;-webkit-font-smoothing:antialiased;overflow-x:hidden;}
    img{display:block;max-width:100%;}
    a{color:inherit;text-decoration:none;}
    .wrap{max-width:1140px;margin:0 auto;padding:0 40px;}
    .narrow{max-width:740px;}
    .eyebrow{font-family:var(--sans);font-size:12px;letter-spacing:4px;text-transform:uppercase;color:var(--red);font-weight:500;}
    h1,h2,h3{font-family:var(--serif);font-weight:500;color:var(--green);line-height:1.16;}
    .btn{display:inline-block;font-family:var(--sans);font-size:13px;letter-spacing:2px;text-transform:uppercase;padding:15px 32px;transition:.2s;border:none;}
    .btn-red{background:var(--red);color:var(--paper);}.btn-red:hover{background:var(--red-dark);}
    .btn-outline{border:1px solid var(--green);color:var(--green);}.btn-outline:hover{background:var(--green);color:var(--paper);}
    .center-mark{width:8px;height:8px;background:var(--red);}

    /* top bar + nav (shared) */
    .topbar{background:var(--green);color:var(--paper);font-family:var(--sans);font-size:12px;letter-spacing:1.5px;text-transform:uppercase;}
    .topbar .wrap{display:flex;justify-content:space-between;align-items:center;padding:9px 40px;}
    .topbar a{color:var(--paper);opacity:.9;}.topbar .t-left span{color:#CFD8C8;}
    header.nav{position:sticky;top:0;z-index:50;background:rgba(245,240,230,.96);backdrop-filter:blur(6px);border-bottom:1px solid var(--line);}
    .nav .wrap{display:flex;align-items:center;justify-content:space-between;padding:16px 40px;}
    .brand{display:flex;align-items:center;gap:11px;}
    .brand .jti{font-family:var(--serif);font-weight:600;font-size:26px;letter-spacing:2px;color:var(--green);}
    .brand .sq{width:11px;height:11px;background:var(--red);}
    .brand .full{font-family:var(--sans);font-size:10px;letter-spacing:3px;color:var(--gold);text-transform:uppercase;line-height:1.3;max-width:90px;}
    .menu{display:flex;align-items:center;gap:26px;font-family:var(--sans);font-size:13px;letter-spacing:1.5px;text-transform:uppercase;color:var(--ink);}
    .menu a:hover{color:var(--red);}
    .menu .enquire{background:var(--red);color:var(--paper);padding:12px 24px;letter-spacing:2px;}
    .menu .enquire:hover{background:var(--red-dark);}
    .burger{display:none;flex-direction:column;gap:5px;cursor:pointer;}
    .burger span{width:26px;height:2px;background:var(--green);}

    /* hero */
    .shero{position:relative;height:66vh;min-height:460px;display:flex;align-items:flex-end;color:var(--paper);}
    .shero img.bg{position:absolute;inset:0;width:100%;height:100%;object-fit:cover;}
    .shero .scrim{position:absolute;inset:0;background:linear-gradient(to top,rgba(15,20,15,.86),rgba(15,20,15,.26) 60%);}
    .shero .inner{position:relative;z-index:2;padding-bottom:50px;max-width:760px;}
    .shero .eyebrow{color:var(--sand);}
    .shero h1{color:var(--paper);font-size:58px;margin:16px 0 20px;}
    .shero .facts{display:flex;gap:34px;flex-wrap:wrap;font-family:var(--sans);font-size:12px;letter-spacing:2px;text-transform:uppercase;color:#EDE7DA;}
    .shero .facts b{display:block;font-family:var(--serif);font-size:26px;color:var(--sand);letter-spacing:0;text-transform:none;margin-bottom:4px;}
    .crumbs{border-bottom:1px solid var(--line);}
    .crumbs .wrap{padding:14px 40px;font-family:var(--sans);font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--gold);}
    .crumbs a:hover{color:var(--red);}

    /* founding story */
    .founding{padding:80px 0 20px;}
    .founding .sechead{margin-bottom:36px;}
    .founding h2{font-size:38px;margin:14px 0 0;}
    .founding p{margin-bottom:24px;font-size:19px;}
    .founding p:first-of-type::first-letter{font-family:var(--serif);float:left;font-size:72px;line-height:.78;font-weight:600;color:var(--red);margin:6px 12px 0 0;}

    /* timeline */
    .tlsec{padding:70px 0 90px;}
    .tlsec .sechead{max-width:640px;margin:0 auto 56px;text-align:center;}
    .tlsec .sechead h2{font-size:36px;margin:14px 0 0;}
    .tl-track{max-width:760px;margin:0 auto;}
    .tl-item{position:relative;padding:0 0 48px 150px;}
    .tl-item::before{content:"";position:absolute;left:96px;top:6px;width:11px;height:11px;border-radius:50%;background:var(--red);border:3px solid var(--paper);box-shadow:0 0 0 1px var(--red);}
    .tl-item::after{content:"";position:absolute;left:101px;top:20px;bottom:0;width:1px;background:var(--line);}
    .tl-item:last-child::after{display:none;}
    .tl-item:last-child{padding-bottom:0;}
    .tl-year{position:absolute;left:0;top:-3px;width:82px;text-align:right;font-family:var(--serif);font-size:21px;color:var(--green);}
    .tl-item h3{font-size:23px;margin-bottom:8px;}
    .tl-item p{font-size:16px;line-height:1.65;color:var(--body);}
    .tl-note{max-width:760px;margin:36px auto 0;font-family:var(--sans);font-size:12.5px;line-height:1.6;color:var(--gold);border-top:1px solid var(--line);padding-top:24px;}

    /* why 3-card */
    .why3{background:var(--paper-deep);padding:80px 0;}
    .why3 .sechead{text-align:center;max-width:640px;margin:0 auto 48px;}
    .why3 .sechead h2{font-size:36px;margin:14px 0 0;}
    .why3grid{display:grid;grid-template-columns:repeat(3,1fr);gap:26px;}
    .why3card{background:var(--paper);border:1px solid var(--line);padding:30px;}
    .why3card .k{font-family:var(--sans);font-size:11px;letter-spacing:1.5px;text-transform:uppercase;color:var(--gold);margin-bottom:10px;}
    .why3card h3{font-size:21px;margin-bottom:12px;}
    .why3card p{font-size:15.5px;line-height:1.6;color:var(--body);}

    /* team */
    .team{padding:80px 0;}
    .team .narrow{margin:0 auto;}
    .team .sechead{margin-bottom:26px;}
    .team h2{font-size:34px;margin:14px 0 20px;}
    .team p{margin-bottom:20px;}
    .team .cta-line{background:var(--paper-deep);border:1px solid var(--line);padding:26px 30px;display:flex;align-items:center;justify-content:space-between;gap:20px;flex-wrap:wrap;margin-top:30px;}
    .team .cta-line p{margin:0;font-family:var(--garamond);font-style:italic;font-size:17px;color:var(--green);}

    /* group / sister brands */
    .groupsec{background:var(--green);color:var(--paper);padding:86px 0;text-align:center;}
    .groupsec .center-mark{margin:0 auto 20px;}
    .groupsec .eyebrow{color:var(--sand);}
    .groupsec h2{color:var(--paper);font-size:36px;margin:14px auto 18px;max-width:640px;}
    .groupsec .gtext{font-family:var(--garamond);font-style:italic;font-size:19px;color:#CFD8C8;max-width:620px;margin:0 auto;}
    .brandrow{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;margin:48px auto 0;max-width:1040px;}
    .brandtile{background:#fff;padding:28px 22px 24px;text-align:center;transition:.25s;display:flex;flex-direction:column;align-items:center;}
    .brandtile:hover{transform:translateY(-4px);box-shadow:0 16px 36px rgba(0,0,0,.25);}
    .brandtile .logo{height:96px;display:flex;align-items:center;justify-content:center;margin-bottom:18px;width:100%;}
    .brandtile .logo img{max-height:96px;max-width:170px;object-fit:contain;filter:grayscale(1);opacity:.85;transition:.25s;}
    .brandtile .logo img.white{filter:brightness(0);opacity:.85;}
    .brandtile:hover .logo img{filter:none;opacity:1;}
    .brandtile:hover .logo img.white{filter:brightness(0);opacity:1;}
    .brandtile .bn{font-family:var(--serif);font-size:22px;color:var(--green);}
    .brandtile .bname{font-family:var(--serif);font-size:19px;color:var(--green);border-top:1px solid var(--line);padding-top:14px;width:100%;}
    .brandtile .bb{font-family:var(--sans);font-size:11.5px;letter-spacing:.5px;line-height:1.5;color:var(--gold);margin-top:6px;}
    @media (max-width:900px){.brandrow{grid-template-columns:1fr 1fr;}}
    .brandnote{font-family:var(--sans);font-size:12px;letter-spacing:1px;color:#9DAD97;margin-top:34px;}

    /* cta */
    .finalcta{background:var(--paper-deep);text-align:center;padding:80px 40px;}
    .finalcta .center-mark{margin:0 auto 20px;}
    .finalcta h2{font-size:36px;margin:14px auto 26px;max-width:560px;}

    /* footer (shared) */
    footer.site{background:#16241B;color:#B9C7B4;padding:64px 0 30px;}
    footer.site .grid-f{display:grid;grid-template-columns:1.4fr 1fr 1fr 1.2fr;gap:44px;}
    footer.site .brand .jti{color:var(--paper);}
    footer.site p.tag{margin-top:18px;font-size:15px;line-height:1.6;color:#9DAD97;max-width:280px;}
    footer.site h4{font-family:var(--sans);font-size:12px;letter-spacing:2px;text-transform:uppercase;color:var(--paper);margin-bottom:18px;}
    footer.site ul{list-style:none;}footer.site li{margin-bottom:11px;font-family:var(--sans);font-size:13px;}
    footer.site li a:hover{color:var(--paper);}
    footer.site .contact{font-family:var(--sans);font-size:13px;line-height:1.9;}
    footer.site .contact a{color:var(--sand);}
    footer.site .sub{border-top:1px solid rgba(255,255,255,.1);margin-top:48px;padding-top:22px;display:flex;justify-content:space-between;font-family:var(--sans);font-size:11px;letter-spacing:1px;color:#7E8E79;flex-wrap:wrap;gap:10px;}
    .wa{position:fixed;right:22px;bottom:22px;z-index:60;background:var(--red);color:var(--paper);font-family:var(--sans);font-size:13px;letter-spacing:1.5px;text-transform:uppercase;padding:14px 22px;box-shadow:0 10px 30px rgba(0,0,0,.25);}
    .wa:hover{background:var(--red-dark);}

    @media (max-width:900px){.why3grid{grid-template-columns:1fr;}}
    @media (max-width:820px){
      .wrap{padding:0 24px;}.topbar .wrap,.nav .wrap,.crumbs .wrap{padding-left:24px;padding-right:24px;}
      .menu{display:none;}.burger{display:flex;}
      .shero h1{font-size:38px;}
      .founding h2{font-size:28px;}
      .tl-item{padding-left:0;padding-top:38px;}
      .tl-year{position:static;text-align:left;width:auto;display:block;margin-bottom:6px;}
      .tl-item::before{left:0;top:38px;}
      .tl-item::after{left:5px;top:52px;}
      footer.site .grid-f{grid-template-columns:1fr 1fr;gap:30px;}
    }
