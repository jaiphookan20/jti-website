  <script>
    function filt(btn, cat){
      document.querySelectorAll('.filter button').forEach(function(b){b.classList.remove('active');});
      btn.classList.add('active');
      document.querySelectorAll('.card').forEach(function(c){
        c.classList.toggle('hide', !(cat==='all' || c.dataset.cat===cat));
      });
    }

    window.addEventListener('DOMContentLoaded',function(){var hsh=(location.hash||'').replace('#','');if(['wildlife','birding','culture'].indexOf(hsh)>=0){var b=document.querySelector('.filter button[data-f="'+hsh+'"]');if(b)filt(b,hsh);}});
  </script>
