
    :root{
      --paper:#F5F0E6;--paper-deep:#E9E2D4;--ink:#2B2B26;--body:#3F3E36;
      --green:#1F3D2B;--green-soft:#2E4A38;--red:#7B2E2A;--red-dark:#5F231F;--gold:#8A7E63;--line:#D8CFBA;--sand:#D9B48A;
      --serif:'Cormorant', Georgia, serif;
      --garamond:'EB Garamond', Georgia, serif;
      --sans:'Jost','Helvetica Neue',Helvetica,Arial,sans-serif;
    }
    *{box-sizing:border-box;margin:0;padding:0;}
    html{scroll-behavior:smooth;}
    body{background:var(--paper);color:var(--body);font-family:var(--garamond);font-size:19px;line-height:1.75;-webkit-font-smoothing:antialiased;overflow-x:hidden;}
    img{display:block;max-width:100%;}
    a{color:inherit;text-decoration:none;}
    .wrap{max-width:1200px;margin:0 auto;padding:0 40px;}
    .narrow{max-width:740px;}
    .eyebrow{font-family:var(--sans);font-size:12px;letter-spacing:4px;text-transform:uppercase;color:var(--red);font-weight:500;}
    h1,h2,h3{font-family:var(--serif);font-weight:500;color:var(--green);line-height:1.14;}
    .btn{display:inline-block;font-family:var(--sans);font-size:13px;letter-spacing:2px;text-transform:uppercase;padding:15px 32px;cursor:pointer;transition:.2s;border:none;}
    .btn-red{background:var(--red);color:var(--paper);}.btn-red:hover{background:var(--red-dark);}
    .center-mark{width:8px;height:8px;background:var(--red);}

    /* top bar + nav (shared) */
    .topbar{background:var(--green);color:var(--paper);font-family:var(--sans);font-size:12px;letter-spacing:1.5px;text-transform:uppercase;}
    .topbar .wrap{display:flex;justify-content:space-between;align-items:center;padding:9px 40px;}
    .topbar a{color:var(--paper);opacity:.9;}.topbar .t-left span{color:#CFD8C8;}
    header.nav{position:sticky;top:0;z-index:50;background:rgba(245,240,230,.96);backdrop-filter:blur(6px);border-bottom:1px solid var(--line);}
    .nav .wrap{display:flex;align-items:center;justify-content:space-between;padding:16px 40px;}
    .brand{display:flex;align-items:center;gap:11px;}
    .brand .jti{font-family:var(--serif);font-weight:600;font-size:26px;letter-spacing:2px;color:var(--green);}
    .brand .sq{width:11px;height:11px;background:var(--red);}
    .brand .full{font-family:var(--sans);font-size:10px;letter-spacing:3px;color:var(--gold);text-transform:uppercase;line-height:1.3;max-width:90px;}
    .menu{display:flex;align-items:center;gap:26px;font-family:var(--sans);font-size:13px;letter-spacing:1.5px;text-transform:uppercase;color:var(--ink);}
    .menu a:hover{color:var(--red);}
    .menu .enquire{background:var(--red);color:var(--paper);padding:12px 24px;letter-spacing:2px;}
    .menu .enquire:hover{background:var(--red-dark);}
    .burger{display:none;flex-direction:column;gap:5px;cursor:pointer;}
    .burger span{width:26px;height:2px;background:var(--green);}

    /* ---------- profile hero: split portrait ---------- */
    .ghero2{position:relative;}
    .gsplit{display:grid;grid-template-columns:.86fr 1.14fr;min-height:640px;}
    .gvisual{position:relative;overflow:hidden;background:linear-gradient(135deg,#6E4633,#2C1D15);}
    .gvisual img{width:100%;height:100%;object-fit:cover;position:absolute;inset:0;}
    .gvscrim{position:absolute;inset:0;background:linear-gradient(to top,rgba(15,20,15,.5) 0%,rgba(15,20,15,0) 40%),linear-gradient(90deg,rgba(0,0,0,0) 82%,rgba(245,240,230,.06) 100%);}
    .gpanel{background:var(--green);color:var(--paper);display:flex;align-items:center;padding:70px 6% 70px 64px;}
    .gpanel .ginner{max-width:520px;}
    .gpanel .eyebrow{color:var(--sand);}
    .gpanel h1{color:var(--paper);font-size:58px;margin:20px 0 10px;line-height:1.05;}
    .grole2{font-family:var(--sans);font-size:13px;letter-spacing:2px;text-transform:uppercase;color:#DCE3D6;margin-bottom:6px;}
    .gyears{font-family:var(--garamond);font-style:italic;font-size:16px;color:var(--sand);margin-bottom:26px;}
    .gintro{font-family:var(--garamond);font-style:italic;font-size:22px;line-height:1.55;color:#EDE7DA;margin-bottom:30px;padding-bottom:30px;border-bottom:1px solid rgba(255,255,255,.16);}
    .gchips{display:flex;flex-wrap:wrap;gap:10px;}
    .gchips .chip{font-family:var(--sans);font-size:11.5px;letter-spacing:.5px;color:var(--paper);border:1px solid rgba(255,255,255,.3);padding:9px 16px;border-radius:40px;}

    .crumbs{border-bottom:1px solid var(--line);}
    .crumbs .wrap{padding:14px 40px;font-family:var(--sans);font-size:11px;letter-spacing:2px;text-transform:uppercase;color:var(--gold);}
    .crumbs a:hover{color:var(--red);}

    /* ---------- bio lead ---------- */
    .gbio{padding:70px 0 10px;}
    .gbio .lead{font-family:var(--garamond);font-style:italic;font-size:25px;line-height:1.55;color:var(--green);}

    /* ---------- interview ---------- */
    .ginterview{padding:60px 0 20px;}
    .isechead{margin-bottom:44px;}
    .isechead h2{font-size:36px;margin-top:12px;}
    .qa{padding:36px 0;border-top:1px solid var(--line);}
    .qa:last-child{border-bottom:1px solid var(--line);}
    .qa .qn{font-family:var(--sans);font-size:11px;letter-spacing:2px;color:var(--gold);margin-bottom:10px;}
    .qa .q{font-family:var(--serif);font-weight:500;font-size:26px;line-height:1.3;color:var(--green);margin-bottom:16px;}
    .qa .a{font-size:19px;line-height:1.75;color:var(--body);position:relative;padding-left:26px;}
    .qa .a::before{content:"";position:absolute;left:0;top:9px;width:10px;height:2px;background:var(--red);}

    /* ---------- favourite place band ---------- */
    .gfav{padding:20px 0 90px;}
    .favbox{background:var(--green);color:var(--paper);padding:64px 56px;text-align:center;position:relative;}
    .favbox::before{content:"";display:block;width:36px;height:3px;background:var(--red);margin:0 auto 24px;}
    .favbox h3{color:var(--paper);font-size:32px;margin:0 0 18px;}
    .favbox p{font-family:var(--garamond);font-style:italic;font-size:21px;line-height:1.55;color:#E7E0D2;max-width:600px;margin:0 auto;}

    /* ---------- cta ---------- */
    .gcta{padding:0 0 96px;text-align:center;}
    .gcta .center-mark{margin:0 auto 20px;}
    .gcta h2{font-size:36px;margin:14px 0 26px;}

    /* ---------- rest of team ---------- */
    .gteam{background:var(--paper-deep);padding:80px 0 90px;}
    .sec-head{text-align:center;max-width:640px;margin:0 auto 48px;}
    .sec-head .center-mark{margin:0 auto 20px;}
    .sec-head h2{font-size:36px;margin:14px 0 0;}
    .gcards{display:grid;grid-template-columns:repeat(4,1fr);gap:22px;}
    .gmini{display:block;text-align:center;}
    .gmini .ph{width:100%;aspect-ratio:1/1;overflow:hidden;border-radius:50%;margin:0 auto 16px;max-width:150px;background:linear-gradient(135deg,#6E4633,#2C1D15);}
    .gmini .ph img{width:100%;height:100%;object-fit:cover;transition:.4s;}
    .gmini:hover .ph img{transform:scale(1.08);}
    .gmini .n{font-family:var(--serif);font-size:19px;color:var(--green);margin-bottom:4px;}
    .gmini .r{font-family:var(--sans);font-size:11px;letter-spacing:1px;text-transform:uppercase;color:var(--gold);}

    /* footer (shared) */
    footer.site{background:#16241B;color:#B9C7B4;padding:64px 0 30px;}
    footer.site .grid-f{display:grid;grid-template-columns:1.4fr 1fr 1fr 1.2fr;gap:44px;}
    footer.site .brand .jti{color:var(--paper);}
    footer.site p.tag{margin-top:18px;font-size:15px;line-height:1.6;color:#9DAD97;max-width:280px;}
    footer.site h4{font-family:var(--sans);font-size:12px;letter-spacing:2px;text-transform:uppercase;color:var(--paper);margin-bottom:18px;}
    footer.site ul{list-style:none;}footer.site li{margin-bottom:11px;font-family:var(--sans);font-size:13px;}
    footer.site li a:hover{color:var(--paper);}
    footer.site .contact{font-family:var(--sans);font-size:13px;line-height:1.9;}
    footer.site .contact a{color:var(--sand);}
    footer.site .sub{border-top:1px solid rgba(255,255,255,.1);margin-top:48px;padding-top:22px;display:flex;justify-content:space-between;font-family:var(--sans);font-size:11px;letter-spacing:1px;color:#7E8E79;flex-wrap:wrap;gap:10px;}
    .wa{position:fixed;right:22px;bottom:22px;z-index:60;background:var(--red);color:var(--paper);font-family:var(--sans);font-size:13px;letter-spacing:1.5px;text-transform:uppercase;padding:14px 22px;box-shadow:0 10px 30px rgba(0,0,0,.25);}
    .wa:hover{background:var(--red-dark);}

    @media (max-width:960px){
      .gsplit{grid-template-columns:1fr;min-height:0;}
      .gvisual{height:52vh;min-height:340px;}
      .gpanel{padding:50px 24px;}
      .gcards{grid-template-columns:repeat(2,1fr);}
    }
    @media (max-width:820px){
      .wrap{padding:0 24px;}.topbar .wrap,.nav .wrap,.crumbs .wrap{padding-left:24px;padding-right:24px;}
      .menu{display:none;}.burger{display:flex;}
      .gpanel h1{font-size:40px;}.gintro{font-size:19px;}
      .qa .q{font-size:22px;}
      .favbox{padding:44px 26px;}.favbox h3{font-size:26px;}.favbox p{font-size:18px;}
    }
